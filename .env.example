# Platform
APP_NAME=ai-platform
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=aiplatform
POSTGRES_DB=aiplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aiplatform:aiplatform@postgres:5432/aiplatform

# Storage
MODEL_STORAGE_PATH=/storage/models
DEPLOYMENT_BUILD_PATH=/storage/builds
MAX_UPLOAD_SIZE_MB=500

# Deployment Engine
DOCKER_NETWORK=ai-platform-net
INFERENCE_HOST_PORT_MIN=9000
INFERENCE_HOST_PORT_MAX=9999
MAX_DEPLOYMENTS_PER_USER=5
DEPLOYMENT_HEALTH_TIMEOUT_SECONDS=60

# Inference Images
INFERENCE_IMAGE_SKLEARN=ai-platform/inference-sklearn:latest
INFERENCE_IMAGE_ONNX=ai-platform/inference-onnx:latest
INFERENCE_IMAGE_PYTORCH=ai-platform/inference-pytorch:latest

# Observability
PROMETHEUS_PORT=9090
PROMETHEUS_TARGETS_PATH=/storage/prometheus/inference_targets.json
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Gateway
NGINX_PORT=8080

# Frontend (use nginx gateway URL in docker compose)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_DOCS_URL=http://localhost:8080/docs
